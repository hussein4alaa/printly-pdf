{
    "name": "g4t/printly",
    "description": "Generate PDFs in Laravel with headless Chrome: first-class Arabic/RTL, custom fonts and colors.",
    "keywords": ["laravel", "pdf", "arabic", "rtl", "chrome", "fonts"],
    "license": "MIT",
    "authors": [
        {
            "name": "Hussein Alaa",
            "email": "hussein4alaa@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "chrome-php/chrome": "^1.11",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "g4t\\Printly\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "g4t\\Printly\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "g4t\\Printly\\PrintlyServiceProvider"
            ],
            "aliases": {
                "Printly": "g4t\\Printly\\Facades\\Printly"
            }
        }
    },
    "minimum-stability": "stable"
}
